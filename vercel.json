{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd project && npm install && npm run build",
  "outputDirectory": "project/dist",
  "installCommand": "echo skip",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{api/**,backend/**,policy_data/notices/**,policy_data/terms.json,policy_data/terms.py}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/notify/kakao",
      "destination": "/api/notify_kakao"
    },
    {
      "source": "/api/terms/lookup",
      "destination": "/api/glossary_lookup"
    },
    {
      "source": "/api/terms",
      "destination": "/api/glossary"
    },
    {
      "source": "/api/auth/kakao",
      "destination": "/api/auth_kakao"
    },
    {
      "source": "/api/users/me/onboarding",
      "destination": "/api/onboarding"
    }
  ]
}
